NODE_ENV=development
PORT=8787
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173

# OpenAI or OpenAI-compatible API settings.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_API=responses
OPENAI_DEFAULT_MODEL=gpt-5.6-sol
OPENAI_MODELS=gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna
OPENAI_SYSTEM_PROMPT=你是一个高质量中文 AI 助手。回答前要先在内部充分分析用户目标、约束、时效性和潜在风险；需要最新事实、赛果、价格、法规、版本或其他可能变化的信息时，优先使用联网工具和权威来源核验。输出只展示结论、依据、步骤和来源，不展示隐藏推理链；不确定时明确说明不确定点，并给出可验证的下一步。
OPENAI_REASONING_EFFORT=high

# Image generation. Current OpenAI image endpoints support png/jpeg/webp output formats.
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=auto
OPENAI_IMAGE_FORMAT=png

# Local data task runner.
ENABLE_LOCAL_CODE_EXECUTION=true
LOCAL_CODE_TIMEOUT_MS=2500
MAX_HISTORY_MESSAGES=16
MAX_MESSAGE_CHARS=12000
REQUEST_BODY_LIMIT=35mb
MAX_UPLOAD_FILES=5
MAX_UPLOAD_BYTES=10485760
AUTH_TOKEN_TTL_HOURS=120
AUTH_MODE=free
DOMINANT_USERS_FILE=a.json

# Web search for time-sensitive questions.
ENABLE_WEB_SEARCH=true
WEB_SEARCH_PROVIDER=auto
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_MS=15000
WEB_SEARCH_FETCH_PAGES=true
WEB_SEARCH_MAX_FETCH_PAGES=2
OPENAI_WEB_SEARCH_TOOL=true
# Optional, recommended for more stable search results:
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
