# Runtime environment.
# NODE_ENV: development or production.
NODE_ENV=development

# HTTP server binding.
# PORT: backend server port.
# HOST: 127.0.0.1 for local-only, 0.0.0.0 for cloud/server public binding.
# CORS_ORIGIN: frontend origin allowed to call the backend during development.
PORT=8787
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173

# OpenAI or OpenAI-compatible API routing.
# AI_TEXT_RUNTIME: openai or codex. codex uses local Codex CLI app-server for text answers.
# User API keys are NOT configured here. They are stored per user in a.json,
# or entered from the webpage when missing.
# OPENAI_BASE_URL: official OpenAI is https://api.openai.com/v1.
# OPENAI_TEXT_API: responses is recommended; chat is only for Chat Completions-compatible services.
# OPENAI_MODELS: comma-separated model list shown in the webpage selector.
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TEXT_RUNTIME=openai
OPENAI_TEXT_API=responses
OPENAI_DEFAULT_MODEL=gpt-5.6-sol
OPENAI_MODELS=gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna

# Codex CLI app-server settings, used when AI_TEXT_RUNTIME=codex.
# Requires a locally installed and logged-in Codex CLI with app-server support.
# CODEX_SANDBOX: read-only or workspace-write.
CODEX_COMMAND=codex
CODEX_DEFAULT_MODEL=gpt-5.1-codex-max
CODEX_MODELS=gpt-5.1-codex-max,gpt-5-codex,gpt-5.1,gpt-5
CODEX_REASONING_EFFORT=high
CODEX_TIMEOUT_MS=180000
CODEX_WORKING_DIR=.
CODEX_SANDBOX=read-only
CODEX_APPROVAL_POLICY=on-request

# System prompt and reasoning quality.
# OPENAI_REASONING_EFFORT: minimal, low, medium, or high. Works with Responses/reasoning-capable models.
OPENAI_SYSTEM_PROMPT=你是一个高质量中文 AI 助手。回答前要先在内部充分分析用户目标、约束、时效性和潜在风险；需要最新事实、赛果、价格、法规、版本或其他可能变化的信息时，优先使用联网工具和权威来源核验。输出只展示结论、依据、步骤和来源，不展示隐藏推理链；不确定时明确说明不确定点，并给出可验证的下一步。
OPENAI_REASONING_EFFORT=high

# Image generation settings.
# OPENAI_IMAGE_FORMAT: png, jpeg, or webp when supported by the upstream image endpoint.
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=auto
OPENAI_IMAGE_FORMAT=png

# Local data runner and request limits.
# ENABLE_LOCAL_CODE_EXECUTION: true allows the sandboxed local JS data runner; false disables it.
# MAX_UPLOAD_BYTES is per file.
ENABLE_LOCAL_CODE_EXECUTION=true
LOCAL_CODE_TIMEOUT_MS=2500
MAX_HISTORY_MESSAGES=16
MAX_MESSAGE_CHARS=12000
REQUEST_BODY_LIMIT=35mb
MAX_UPLOAD_FILES=5
MAX_UPLOAD_BYTES=10485760

# Authentication.
# AUTH_MODE:
#   free     - users can self-register; account hashes live in storage/auth/users.json.
#   dominant - only accounts listed in DOMINANT_USERS_FILE can log in; registration is disabled.
# DOMINANT_USERS_FILE: private root-level JSON file, usually a.json. It may also store each user's openaiApiKey.
AUTH_TOKEN_TTL_HOURS=120
AUTH_MODE=free
DOMINANT_USERS_FILE=a.json

# Web search.
# ENABLE_WEB_SEARCH: true enables search for time-sensitive questions.
# WEB_SEARCH_PROVIDER: auto, serper, brave, tavily, or duckduckgo.
# OPENAI_WEB_SEARCH_TOOL: true lets official OpenAI Responses use hosted web_search.
# Third-party OpenAI-compatible proxies may not support hosted web_search; set false to skip failing hosted calls.
ENABLE_WEB_SEARCH=true
WEB_SEARCH_PROVIDER=auto
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_MAX_QUERIES=4
WEB_SEARCH_TIMEOUT_MS=15000
WEB_SEARCH_FETCH_PAGES=true
WEB_SEARCH_MAX_FETCH_PAGES=4
WEB_SEARCH_MAX_PAGE_CHARS=12000
WEB_SEARCH_MAX_CONTEXT_CHARS=20000
OPENAI_WEB_SEARCH_TOOL=true

# Optional external search API keys used when hosted OpenAI web_search is unavailable or disabled.
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
